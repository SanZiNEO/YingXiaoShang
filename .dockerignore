# Docker build context = 仓库根（冻结 §10.4）。
# 本文件只作用于 server 镜像（apps/server/Dockerfile）；crawler 镜像的 context 是
# services/news-crawler-py，用那份目录自己的 .dockerignore。
#
# 目标是「干净克隆后 docker build 能跑」：只放行构建真正需要的路径，
# 其余一律不进上下文（否则 GB 级的 .scratch / example / release 会拖垮每次构建）。

# 依赖与编译产物：一律在构建阶段重新生成
node_modules
**/node_modules
**/lib
**/out
**/dist
*.tsbuildinfo

# 版本控制、本地状态与运行时数据
.git
.gitignore
.learning-agent
.scratch
.zhi
release
.venv
probe
probe-tmp

# 构建只需要 data/normalized（种子库的输入）；其余数据目录是素材与本地库
data/legacy
data/students
data/*.db

# 与服务端构建无关的大目录
example
resources
services
tools
plans
legacy
profiles

# 桌面端只需要模板（ArtifactService 的 templatesDir）
apps/desktop/*
!apps/desktop/templates
!apps/desktop/templates/**

# 文档不进镜像：契约文件在构建阶段由 src/rpc/registry.ts 生成
docs
