apps/desktop/out/
apps/desktop/dist/
apps/desktop/seed/
apps/web/dist/
*.tsbuildinfo
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Tool leftovers: electron-vite 临时配置、原子写入残留的空目录
_tmp_*/
apps/desktop/electron.vite.config.*.mjs

