__pycache__/
*.pyc
*.pdf
data/**/*.png
.env

# Local scratch work and runtime state — never commit
.scratch/
.learning-agent/
.zhi/
release/

# Read-only course materials — never commit
resources/

# Build output and dependencies
node_modules/
lib/
