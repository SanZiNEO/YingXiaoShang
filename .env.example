# Copy to .env and fill in. .env is gitignored.
DEEPSEEK_API_KEY=
# Model used by pipeline:tag and the real-LLM smoke check.
DEEPSEEK_MODEL=deepseek-chat
# Optional: defaults to <repo>/.learning-agent
# LEARNING_AGENT_HOME=
# Optional: tool result retention (UTF-8 bytes) and per-turn prune trigger (code points).
# LEARNING_AGENT_TOOL_MAX_BYTES=36000
# LEARNING_AGENT_TURN_TOOL_MAX_CHARS=48000
# Non-loopback Web listeners require a non-empty access token.
# LEARNING_AGENT_ACCESS_TOKEN=replace-with-a-long-random-token
