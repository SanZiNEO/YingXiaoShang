# Copy to .env and fill in. .env is gitignored.
DEEPSEEK_API_KEY=
# Model for pipeline:tag and the desktop app; both default to deepseek-chat.
DEEPSEEK_MODEL=deepseek-chat
# Optional: defaults to <repo>/.learning-agent
# LEARNING_AGENT_HOME=
# Optional: tool result retention (UTF-8 bytes) and per-turn prune trigger (code points).
# LEARNING_AGENT_TOOL_MAX_BYTES=36000
# LEARNING_AGENT_TURN_TOOL_MAX_CHARS=48000
